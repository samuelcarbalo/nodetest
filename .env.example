NODE_ENV=development
PORT=3000

# Docker Compose reads these names for the MongoDB container.
MONGODB_PORT=27017
MONGODB_USER=auco
MONGODB_PASSWORD=auco_dev
MONGODB_DB=auco
MONGODB_URI=mongodb://auco:auco_dev@localhost:27017/auco?authSource=admin

# CountryStateCity: GET /v1/countries with header X-CSCAPI-KEY.
# Leave CSC_API_KEY empty to start without a key. Lookups are stored as
# enrichment.status "degraded" (reason "unavailable") and the process keeps running.
# Do not commit a real key.
CSC_API_KEY=
COUNTRIES_API_BASE_URL=https://api.countrystatecity.in/v1
COUNTRIES_API_TIMEOUT_MS=3000

# DynamoDB Local accepts any static credentials. Do not reuse these in AWS.
DYNAMODB_PORT=8000
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_AUDIT_TABLE=audit_events
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
