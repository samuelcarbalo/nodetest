{
  "name": "auco",
  "version": "0.1.0",
  "private": true,
  "description": "REST service with Express, MongoDB, and DynamoDB Local",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --import tsx --test test/validations.test.ts test/audit-log.test.ts",
    "test:http": "vitest run",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v",
    "db:init:audit": "tsx --env-file=.env src/scripts/init-audit-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "express": "^5.1.0",
    "mongodb": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
